<% content_for :title, "Entrar" %>

<h1>Entrar</h1>

<%= form_with url: login_path, method: :post, scope: :user do |f| %>
  <p>
    <%= f.label :username %>
    <%= f.text_field :username %>
  </p>
  <p>
    <%= f.label :password, "Senha" %>
    <%= f.password_field :password %>
  </p>
  <%= f.submit "Entrar" %>
<% end %>
