<% content_for :title, "Novo link" %>

<h1>Novo link para <%= @album&.nome %></h1>

<%= form_with model: @link, url: links_path do |f| %>
  <% if @link.errors.any? %>
    <ul class="errors">
      <% @link.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= hidden_field_tag :banda, params[:banda] %>
  <%= hidden_field_tag :album, params[:album] %>

  <p>
    <%= f.label :url %>
    <%= f.text_field :url %>
  </p>

  <%= f.submit "Adicionar" %>
<% end %>
