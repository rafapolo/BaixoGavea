<% content_for :title, @link.url %>

<h1><%= link_to @link.url, @link.url %></h1>

<p>Adicionado por <%= link_to @link.user.username, usuario_path(@link.user.username) %></p>

<h2>Comentários</h2>
<ul>
  <% @votos.each do |voto| %>
    <li>
      <%= voto.ponto == 1 ? "👍" : "👎" %>
      <%= voto.user.username %>: <%= voto.comentario %>
    </li>
  <% end %>
</ul>

<% if logged_in? %>
  <%= form_with model: @voto, url: votos_path do |f| %>
    <%= f.hidden_field :link_id, value: @link.id %>
    <p>
      <%= f.label :comentario %>
      <%= f.text_field :comentario %>
    </p>
    <p>
      <label><%= f.radio_button :ponto, 1 %> Funciona</label>
      <label><%= f.radio_button :ponto, -1 %> Quebrado</label>
    </p>
    <%= f.submit "Comentar" %>
  <% end %>
<% else %>
  <p><%= link_to "Entre para comentar", login_path %></p>
<% end %>
