<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "BaixoGavea" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="BaixoGavea">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body>
    <header>
      <nav>
        <%= link_to "BaixoGavea", root_path %>
        <%= link_to "Torrents", torrents_path %>
        <% if logged_in? %>
          <%= link_to "Meu perfil", usuario_path(current_user.username) %>
          <%= button_to "Sair", logout_path, method: :delete %>
        <% else %>
          <%= link_to "Entrar", login_path %>
          <%= link_to "Cadastrar", novo_usuario_path %>
        <% end %>
      </nav>
    </header>

    <% if flash[:notice] %>
      <p class="notice"><%= flash[:notice] %></p>
    <% end %>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
