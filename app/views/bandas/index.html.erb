<% content_for :title, "BaixoGavea" %>

<h1>BaixoGavea</h1>

<p>
  <%= @bandas_count %> bandas, <%= @albuns_count %> álbuns, <%= @users_count %> usuários confirmados.
</p>

<nav>
  <% ("a".."z").each do |letra| %>
    <%= link_to letra, bandas_por_letra_path(letra: letra) %>
  <% end %>
  <%= link_to "0-9", bandas_por_letra_path(letra: "9") %>
</nav>

<% if params[:letra] %>
  <h2>Bandas com "<%= params[:letra] %>"</h2>
  <ul>
    <% @bandas.each do |banda| %>
      <li><%= link_to banda.nome, banda_path(banda.atalho) %></li>
    <% end %>
  </ul>
<% end %>

<h2>Álbuns recentes</h2>
<ul>
  <% @ultimos_albuns.each do |album| %>
    <li><%= link_to "#{album.banda.nome} - #{album.nome}", album_path(banda: album.banda.atalho, album: album.atalho) %></li>
  <% end %>
</ul>

<%= link_to "Adicionar banda", nova_banda_path %>
