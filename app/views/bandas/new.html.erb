<% content_for :title, "Nova banda" %>

<h1>Nova banda</h1>

<%= form_with model: @banda, url: bandas_path do |f| %>
  <% if @banda.errors.any? %>
    <ul class="errors">
      <% @banda.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <p>
    <%= f.label :nome %>
    <%= f.text_field :nome %>
  </p>

  <%= f.submit "Adicionar" %>
<% end %>
