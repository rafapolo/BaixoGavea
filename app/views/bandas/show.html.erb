<% content_for :title, @banda.nome %>

<h1><%= @banda.nome %></h1>

<ul>
  <% @banda_albuns.each do |album| %>
    <li><%= link_to "#{album.nome} (#{album.ano})", album_path(banda: @banda.atalho, album: album.atalho) %></li>
  <% end %>
</ul>

<%= link_to "Adicionar álbum", novo_album_path(banda: @banda.atalho) %>
